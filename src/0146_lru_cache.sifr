# LeetCode 146: Lru Cache

# Use integer node ids instead of a cyclic Node graph; this keeps the fixture
# ownership-safe while preserving the doubly-linked-list LRU behavior.
class LRUCache:
    cap: int
    head: int
    tail: int
    next_id: int
    key_to_node: dict[int, int]
    node_key: dict[int, int]
    node_value: dict[int, int]
    prev: dict[int, int]
    next: dict[int, int]

    def __init__(self, capacity: int):
        self.cap = capacity
        self.head = 0
        self.tail = 1
        self.next_id = 2
        self.key_to_node = {}
        self.node_key = {}
        self.node_value = {}
        self.prev = {1: 0}
        self.next = {0: 1}

    def detach(mut self, node: int) -> None:
        left: int | None = self.prev[node]
        right: int | None = self.next[node]
        if left is None or right is None:
            return
        self.next[left] = right
        self.prev[right] = left
        del self.prev[node]
        del self.next[node]

    def insertAfter(mut self, node: int, left: int) -> None:
        right: int | None = self.next[left]
        if right is None:
            return
        self.prev[node] = left
        self.next[node] = right
        self.next[left] = node
        self.prev[right] = node

    def moveToFront(mut self, node: int) -> None:
        self.detach(node)
        head = self.head
        self.insertAfter(node, head)

    def evictLru(mut self) -> None:
        node_opt: int | None = self.prev[self.tail]
        if node_opt is None:
            return
        node: int = node_opt
        if node == self.head:
            return

        key: int | None = self.node_key[node]
        if key is not None:
            del self.key_to_node[key]
        del self.node_key[node]
        del self.node_value[node]
        self.detach(node)

    def get(mut self, key: int) -> int:
        node: int | None = self.key_to_node[key]
        if node is None:
            return -1

        value: int | None = self.node_value[node]
        if value is None:
            return -1
        self.moveToFront(node)
        return value

    def put(mut self, key: int, value: int) -> None:
        if self.cap <= 0:
            return

        existing: int | None = self.key_to_node[key]
        if existing is not None:
            self.node_value[existing] = value
            self.moveToFront(existing)
            return

        if len(self.key_to_node) >= self.cap:
            self.evictLru()

        node = self.next_id
        self.next_id = self.next_id + 1
        self.key_to_node[key] = node
        self.node_key[node] = key
        self.node_value[node] = value
        head = self.head
        self.insertAfter(node, head)

def main():
    obj = LRUCache(2)
    obj.put(1, 1)
    obj.put(2, 2)
    assert obj.get(1) == 1
    obj.put(3, 3)
    assert obj.get(2) == -1
    obj.put(4, 4)
    assert obj.get(1) == -1
    assert obj.get(3) == 3
    assert obj.get(4) == 4
    obj2 = LRUCache(1)
    obj2.put(8, -1)
    assert obj2.get(8) == -1
    obj2.put(9, 9)
    assert obj2.get(8) == -1
    assert obj2.get(9) == 9
