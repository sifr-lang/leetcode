# LeetCode 146: Lru Cache

# Use integer node ids instead of a cyclic Node graph; this keeps the fixture
# ownership-safe while preserving the doubly-linked-list LRU behavior.
class LRUCache:
    cap: int
    head: int
    tail: int
    next_id: int
    key_to_node: dict[int, int]
    node_key: dict[int, int]
    node_value: dict[int, int]
    prev: dict[int, int]
    next: dict[int, int]

    def __init__(self, capacity: int):
        self.cap = capacity
        self.head = 0
        self.tail = 1
        self.next_id = 2
        self.key_to_node = {}
        self.node_key = {}
        self.node_value = {}
        self.prev = {1: 0}
        self.next = {0: 1}

    def detach(mut self, node: int) -> Result[None, Error]:
        try:
            left: int | None = self.prev[node]
            right: int | None = self.next[node]
            if left is None or right is None:
                return
            self.next[left] = right
            self.prev[right] = left
            del self.prev[node]
            del self.next[node]
            return None
        except Error as error:
            raise error

    def insertAfter(mut self, node: int, left: int) -> None:
        right: int | None = self.next[left]
        if right is None:
            return
        self.prev[node] = left
        self.next[node] = right
        self.next[left] = node
        self.prev[right] = node

    def moveToFront(mut self, node: int) -> Result[None, Error]:
        try:
            detach_completion_1: None = self.detach(node)
            head = self.head
            self.insertAfter(node, head)
            return None
        except Error as error:
            raise error

    def evictLru(mut self) -> Result[None, Error]:
        try:
            node_opt: int | None = self.prev[self.tail]
            if node_opt is None:
                return
            node: int = node_opt
            if node == self.head:
                return

            key: int | None = self.node_key[node]
            if key is not None:
                del self.key_to_node[key]
            del self.node_key[node]
            del self.node_value[node]
            detach_completion_2: None = self.detach(node)
            return None
        except Error as error:
            raise error

    def get(mut self, key: int) -> Result[int, Error]:
        try:
            node: int | None = self.key_to_node[key]
            if node is None:
                return -1

            value: int | None = self.node_value[node]
            if value is None:
                return -1
            move_to_front_completion_3: None = self.moveToFront(node)
            return value
        except Error as error:
            raise error

    def put(mut self, key: int, value: int) -> Result[None, Error]:
        try:
            if self.cap <= 0:
                return

            existing: int | None = self.key_to_node[key]
            if existing is not None:
                self.node_value[existing] = value
                move_to_front_completion_4: None = self.moveToFront(existing)
                return

            if len(self.key_to_node) >= self.cap:
                evict_lru_completion_5: None = self.evictLru()

            node = self.next_id
            self.next_id = self.next_id + 1
            self.key_to_node[key] = node
            self.node_key[node] = key
            self.node_value[node] = value
            head = self.head
            self.insertAfter(node, head)
            return None
        except Error as error:
            raise error

def main():
    try:
        obj = LRUCache(2)
        put_completion_6: None = obj.put(1, 1)
        put_completion_7: None = obj.put(2, 2)
        get_result_8: int = obj.get(1)
        assert get_result_8 == 1
        put_completion_9: None = obj.put(3, 3)
        get_result_10: int = obj.get(2)
        assert get_result_10 == -1
        put_completion_11: None = obj.put(4, 4)
        get_result_12: int = obj.get(1)
        assert get_result_12 == -1
        get_result_13: int = obj.get(3)
        assert get_result_13 == 3
        get_result_14: int = obj.get(4)
        assert get_result_14 == 4
        obj2 = LRUCache(1)
        put_completion_15: None = obj2.put(8, -1)
        get_result_16: int = obj2.get(8)
        assert get_result_16 == -1
        put_completion_17: None = obj2.put(9, 9)
        get_result_18: int = obj2.get(8)
        assert get_result_18 == -1
        get_result_19: int = obj2.get(9)
        assert get_result_19 == 9
    except Error:
        assert False
