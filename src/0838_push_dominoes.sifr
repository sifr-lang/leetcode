# LeetCode 838: Push Dominoes

def pushDominoes(dominoes: str) -> Result[str, Error]:
    try:
        dom = list(dominoes)
        q: list[tuple[int, str]] = []
        for i, d in enumerate(dom):
            if d != '.':
                q.append((i, d))
    
        while len(q) > 0:
            pair0 = q.pop(0)
            i = pair0[0]
            d = pair0[1]

            if d == 'L' and i > 0 and dom[i - 1] == '.':
                q.append((i - 1, 'L'))
                dom[i - 1] = 'L'
            elif d == 'R':
                if i + 1 < len(dom) and dom[i + 1] == '.':
                    if i + 2 < len(dom) and dom[i + 2] == 'L':
                        _ = q.pop(0)
                    else:
                        q.append((i + 1, 'R'))
                        dom[i + 1] = 'R'

        return ''.join(dom)
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: str = pushDominoes('RR.L')
        assert contract_result_1 == 'RR.L'
        contract_result_2: str = pushDominoes('.L.R...LR..L..')
        assert contract_result_2 == 'LL.RR.LLRRLL..'
    except Error:
        assert False
