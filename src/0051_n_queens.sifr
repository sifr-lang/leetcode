# LeetCode 51: N Queens

def renderBoard(board: list[list[str]]) -> list[str]:
    rendered: list[str] = []
    for row in board:
        rendered.append("".join(row))
    return rendered

def backtrackNQueens(
    r: int,
    n: int,
    mut board: list[list[str]],
    mut col: set[int],
    mut posDiag: set[int],
    mut negDiag: set[int],
    mut res: list[list[str]],
) -> Result[None, Error]:
    try:
        if r == n:
            res.append(renderBoard(board))
            return

        for c in range(n):
            if c in col or (r + c) in posDiag or (r - c) in negDiag:
                continue

            col.add(c)
            posDiag.add(r + c)
            negDiag.add(r - c)
            board[r][c] = "Q"

            contract_result_1: None = backtrackNQueens(r + 1, n, board, col, posDiag, negDiag, res)

            col.remove(c)
            posDiag.remove(r + c)
            negDiag.remove(r - c)
            board[r][c] = "."
        return None
    except Error as error:
        raise error

def solveNQueens(n: int) -> Result[list[list[str]], Error]:
    try:
        col = set()
        posDiag = set()  # (r + c)
        negDiag = set()  # (r - c)

        res: list[list[str]] = []
        board = [["."] * n for i in range(n)]
        contract_result_2: None = backtrackNQueens(0, n, board, col, posDiag, negDiag, res)
        return res
    except Error as error:
        raise error

def main():
    try:
        contract_result_3: list[list[str]] = solveNQueens(4)
        assert contract_result_3 == [['.Q..', '...Q', 'Q...', '..Q.'], ['..Q.', 'Q...', '...Q', '.Q..']]
        contract_result_4: list[list[str]] = solveNQueens(1)
        assert contract_result_4 == [['Q']]
    except Error:
        assert False
