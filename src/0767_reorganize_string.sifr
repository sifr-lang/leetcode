# LeetCode 767: Reorganize String

from sifr.collections import defaultdict

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def reorganizeString(s: str) -> Result[str, Error]:
    try:
        count = defaultdict(int)
        for c in s:
            count[c] += 1
        n = len(s)
        max_char = ""
        max_freq = 0
        for char, freq in count.items():
            f = _nz_int(freq)
            if f > max_freq:
                max_freq = f
                max_char = char
        if max_freq > (n + 1) // 2:
            return ""

        res = ["" for _ in range(n)]
        idx = 0

        remaining = max_freq
        while remaining > 0:
            res[idx] = max_char
            idx += 2
            remaining -= 1

        for char, freq in count.items():
            f = _nz_int(freq)
            if char == max_char:
                f -= max_freq
            while f > 0:
                if idx >= n:
                    idx = 1
                res[idx] = char
                idx += 2
                f -= 1
        return "".join(res)
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: str = reorganizeString('aab')
        assert contract_result_1 == 'aba'
        contract_result_2: str = reorganizeString('aaab')
        assert contract_result_2 == ''
    except Error:
        assert False
