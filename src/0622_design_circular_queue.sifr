# LeetCode 622: Design Circular Queue

from helpers.safe_math import mod_or_zero

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value


class MyCircularQueue:
    data: list[int]
    head: int
    size: int
    capacity: int

    def __init__(self, k: int):
        self.data = [0] * k
        self.head = 0
        self.size = 0
        self.capacity = k

    def enQueue(mut self, value: int) -> Result[bool, Error]:
        try:
            if self.isFull():
                return False
            tail = mod_or_zero(self.head + self.size, self.capacity)
            self.data[tail] = value
            self.size += 1
            return True
        except Error as error:
            raise error

    def deQueue(mut self) -> bool:
        if self.isEmpty():
            return False
        self.head = mod_or_zero(self.head + 1, self.capacity)
        self.size -= 1
        return True

    def Front(self) -> int:
        if self.isEmpty():
            return -1
        return unwrapInt(self.data[self.head])

    def Rear(self) -> int:
        if self.isEmpty():
            return -1
        tail = mod_or_zero(self.head + self.size - 1, self.capacity)
        return unwrapInt(self.data[tail])

    def isEmpty(self) -> bool:
        return self.size == 0

    def isFull(self) -> bool:
        return self.capacity == self.size


def main():
    try:
        obj = MyCircularQueue(3)
        contract_result_1: bool = obj.enQueue(1)
        assert contract_result_1 == True
        contract_result_2: bool = obj.enQueue(2)
        assert contract_result_2 == True
        contract_result_3: bool = obj.enQueue(3)
        assert contract_result_3 == True
        contract_result_4: bool = obj.enQueue(4)
        assert contract_result_4 == False
        assert obj.Rear() == 3
        assert obj.isFull() == True
        assert obj.deQueue() == True
        contract_result_5: bool = obj.enQueue(4)
        assert contract_result_5 == True
        assert obj.Rear() == 4
    except Error:
        assert False
