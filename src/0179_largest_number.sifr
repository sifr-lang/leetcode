# LeetCode 179: Largest Number

def unwrapStr(own value: str | None) -> str:
    if value is None:
        return ""
    return value

def repeatKey(value: str) -> str:
    return value + value + value + value + value + value + value + value + value + value

def largestNumber(mut nums: list[int]) -> str:
    values = []
    for n in nums:
        values.append(str(n))

    values = sorted(values, key=repeatKey)
    values.reverse()

    joined = "".join(values)
    k = 0
    while k + 1 < len(joined) and joined[k] == "0":
        k += 1
    return joined[k:]

def main():
    assert str(largestNumber([10,2])) == '210'
    assert str(largestNumber([3,30,34,5,9])) == '9534330'
