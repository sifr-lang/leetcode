# LeetCode 875: Koko Eating Bananas

from helpers.safe_math import ceil_div_positive_or_zero, div_or_zero

def minEatingSpeed(piles: list[int], h: int) -> int:
    max_p = max(piles)
    if max_p is None:
        return 0

    l: int = 1
    r: int = max_p
    res: int = r
    k: int = 1

    while l <= r:
        k = div_or_zero(l + r, 2)

        totalTime: int = 0
        for p in piles:
            totalTime += ceil_div_positive_or_zero(p, k)
        if totalTime <= h:
            res = k
            r = k - 1
        else:
            l = k + 1
    return res

def main():
    assert str(minEatingSpeed([3,6,7,11], 8)) == '4'
    assert str(minEatingSpeed([30,11,23,4,20], 5)) == '30'
