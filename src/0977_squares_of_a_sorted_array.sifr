# LeetCode 977: Squares Of A Sorted Array

def sortedSquares(nums: list[int]) -> Result[list[int], Error]:
    try:
        n = len(nums)
        res: list[int] = [0] * n
        l = 0
        r = n - 1

        while l <= r:
            left_raw = nums[l]
            left = 0
            if left_raw is not None:
                left = abs(left_raw)
            else:
                l += 1
                continue
            right_raw = nums[r]
            right = 0
            if right_raw is not None:
                right = abs(right_raw)
            else:
                r -= 1
                continue
            idx = r - l
            if left > right:
                res[idx] = left * left
                l += 1
            else:
                res[idx] = right * right
                r -= 1
        return res
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: list[int] = sortedSquares([-4,-1,0,3,10])
        assert str(contract_result_1) == '[0, 1, 9, 16, 100]'
    except Error:
        assert False
