# LeetCode 402: Remove K Digits

def unwrapStr(value: str | None) -> str:
    if value is None:
        return ""
    return "" + value

def removeKdigits(num: str, mut k: int) -> str:
    stack: list[str] = []
    for ch in num:
        while len(stack) > 0 and unwrapStr(stack[-1]) > ch and k > 0:
            k -= 1
            stack.pop()
        if len(stack) > 0 or ch != "0":
            stack.append(ch)
    if k > 0:
        if k >= len(stack):
            stack = []
        else:
            stack = stack[:-k]
    out = "".join(stack)
    if out == "":
        return "0"
    return out

def main():
    assert str(removeKdigits("1432219", 3)) == '1219'
    assert str(removeKdigits("10200", 1)) == '200'
    assert str(removeKdigits("10", 2)) == '0'
