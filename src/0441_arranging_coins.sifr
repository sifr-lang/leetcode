# LeetCode 441: Arranging Coins

from helpers.safe_math import div_or_zero

def arrangeCoins(n: int) -> int:
    l, r = 1, n
    res = 0
    while l <=r:
        mid = div_or_zero(l+r, 2)
        coins = div_or_zero(mid * (mid + 1), 2)
        if coins > n:
            r = mid - 1
        else:
            l = mid + 1
            res = max(mid, res)
    return res

def main():
    assert str(arrangeCoins(5)) == '2'
    assert str(arrangeCoins(8)) == '3'

