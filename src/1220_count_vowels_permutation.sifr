# LeetCode 1220: Count Vowels Permutation

from helpers.safe_math import mod_or_zero

def countVowelPermutation(n: int, c: str = '') -> int:
    MOD = 1000000007
    if n <= 0:
        return 0

    a, e, i, o, u = 0, 0, 0, 0, 0
    if c == '':
        a, e, i, o, u = 1, 1, 1, 1, 1
    elif c == 'a':
        a = 1
    elif c == 'e':
        e = 1
    elif c == 'i':
        i = 1
    elif c == 'o':
        o = 1
    elif c == 'u':
        u = 1
    else:
        return 0

    for _ in range(1, n):
        nextA = mod_or_zero(e + i + u, MOD)
        nextE = mod_or_zero(a + i, MOD)
        nextI = mod_or_zero(e + o, MOD)
        nextO = mod_or_zero(i, MOD)
        nextU = mod_or_zero(i + o, MOD)
        a, e, i, o, u = nextA, nextE, nextI, nextO, nextU

    return mod_or_zero(a + e + i + o + u, MOD)

def main():
    assert str(countVowelPermutation(1)) == '5'
    assert str(countVowelPermutation(2)) == '10'
    assert str(countVowelPermutation(5)) == '68'
