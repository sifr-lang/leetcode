# LeetCode 1631: Path With Minimum Effort
from sifr.heapq import heappop, heappush
from helpers.safe_math import div_or_zero, mod_or_zero

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value

def unwrapBool(value: bool | None) -> bool:
    if value is None:
        return False
    return value

def getIntCell(matrix: list[list[int]], r: int, c: int) -> int:
    row = matrix[r]
    if row is None:
        return 0
    return unwrapInt(row[c])

def setIntCell(mut matrix: list[list[int]], r: int, c: int, value: int) -> None:
    row = matrix[r]
    if row is None:
        return
    row[c] = value
    matrix[r] = row

def getBoolCell(matrix: list[list[bool]], r: int, c: int) -> bool:
    row = matrix[r]
    if row is None:
        return False
    return unwrapBool(row[c])

def setBoolCell(mut matrix: list[list[bool]], r: int, c: int, value: bool) -> None:
    row = matrix[r]
    if row is None:
        return
    row[c] = value
    matrix[r] = row

def minimumEffortPath(heights: list[list[int]]) -> int:
    m = len(heights)
    if m == 0:
        return 0

    first_row = heights[0]
    if first_row is None:
        return 0
    n = len(first_row)
    if n == 0:
        return 0

    inf = 1_000_000_000
    dist: list[list[int]] = []
    for _ in range(m):
        dist.append([inf] * n)
    setIntCell(dist, 0, 0, 0)

    base = max(m, n) + 1
    heap: list[int] = [0]
    while len(heap) > 0:
        item: int | None = heappop(heap)
        if item is not None:
            encoded: int = item
            best = div_or_zero(encoded, base * base)
            position = mod_or_zero(encoded, base * base)
            r = div_or_zero(position, base)
            c = mod_or_zero(position, base)
            if best > getIntCell(dist, r, c):
                continue
            if r == m - 1 and c == n - 1:
                return best

            directions: list[tuple[int, int]] = [(1, 0), (-1, 0), (0, 1), (0, -1)]
            for direction in directions:
                dr = direction[0]
                dc = direction[1]
                if dr is None or dc is None:
                    continue

                nr = r + dr
                nc = c + dc
                if nr < 0 or nc < 0 or nr >= m or nc >= n:
                    continue

                height_cur = getIntCell(heights, r, c)
                height_next = getIntCell(heights, nr, nc)
                edge = abs(height_next - height_cur)
                effort = best
                if edge > effort:
                    effort = edge

                if effort < getIntCell(dist, nr, nc):
                    setIntCell(dist, nr, nc, effort)
                    heappush(heap, (effort * base * base) + (nr * base) + nc)

    return getIntCell(dist, m - 1, n - 1)

def main():
    assert minimumEffortPath([[1, 2, 2], [3, 8, 2], [5, 3, 5]]) == 2
    assert minimumEffortPath([[1, 2, 3], [3, 8, 4], [5, 3, 5]]) == 1
    assert minimumEffortPath([
        [1, 2, 1, 1, 1],
        [1, 2, 1, 2, 1],
        [1, 2, 1, 2, 1],
        [1, 2, 1, 2, 1],
        [1, 1, 1, 2, 1],
    ]) == 0
