# LeetCode 269: Alien Dictionary

def _nz_str(value: str | None) -> str:
    if value is None:
        return ""
    return str(value)

def _nz_bool(value: bool | None) -> bool:
    if value is None:
        return False
    return value

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def _char_index(ch: str) -> int:
    if ch == "a":
        return 0
    if ch == "b":
        return 1
    if ch == "c":
        return 2
    if ch == "d":
        return 3
    if ch == "e":
        return 4
    if ch == "f":
        return 5
    if ch == "g":
        return 6
    if ch == "h":
        return 7
    if ch == "i":
        return 8
    if ch == "j":
        return 9
    if ch == "k":
        return 10
    if ch == "l":
        return 11
    if ch == "m":
        return 12
    if ch == "n":
        return 13
    if ch == "o":
        return 14
    if ch == "p":
        return 15
    if ch == "q":
        return 16
    if ch == "r":
        return 17
    if ch == "s":
        return 18
    if ch == "t":
        return 19
    if ch == "u":
        return 20
    if ch == "v":
        return 21
    if ch == "w":
        return 22
    if ch == "x":
        return 23
    if ch == "y":
        return 24
    if ch == "z":
        return 25
    return 0

def _index_char(i: int) -> str:
    if i == 0:
        return "a"
    if i == 1:
        return "b"
    if i == 2:
        return "c"
    if i == 3:
        return "d"
    if i == 4:
        return "e"
    if i == 5:
        return "f"
    if i == 6:
        return "g"
    if i == 7:
        return "h"
    if i == 8:
        return "i"
    if i == 9:
        return "j"
    if i == 10:
        return "k"
    if i == 11:
        return "l"
    if i == 12:
        return "m"
    if i == 13:
        return "n"
    if i == 14:
        return "o"
    if i == 15:
        return "p"
    if i == 16:
        return "q"
    if i == 17:
        return "r"
    if i == 18:
        return "s"
    if i == 19:
        return "t"
    if i == 20:
        return "u"
    if i == 21:
        return "v"
    if i == 22:
        return "w"
    if i == 23:
        return "x"
    if i == 24:
        return "y"
    if i == 25:
        return "z"
    return ""

def _append_present(mut present_order: list[int], idx: int) -> None:
    if idx not in present_order:
        present_order.append(idx)

def _has_prefix(w1: str, w2: str, length: int) -> bool:
    j = 0
    while j < length:
        if _nz_str(w1[j]) != _nz_str(w2[j]):
            return False
        j += 1
    return True

def _dfs_visit(
    node: int,
    mut states: list[int],
    edges: list[list[bool]],
    order: list[int],
    mut output: list[int],
) -> bool:
    state = _nz_int(states[node])
    if state == 1:
        return True
    if state == 2:
        return False

    states[node] = 1
    row: list[bool] | None = edges[node]
    if row is not None:
        for neighbor in order:
            if _nz_bool(row[neighbor]):
                if _dfs_visit(neighbor, states, edges, order, output):
                    return True
    states[node] = 2
    output.append(node)
    return False

def alienOrder(words: list[str]) -> str:
    present_order: list[int] = []
    edges = []
    for _ in range(26):
        edges.append([False for _ in range(26)])

    for word in words:
        for ch in word:
            _append_present(present_order, _char_index(ch))

    i = 0
    while i + 1 < len(words):
        w1 = words[i]
        w2 = words[i + 1]
        min_len = min(len(w1), len(w2))

        j = 0
        found_diff = False
        while j < min_len:
            c1 = _nz_str(w1[j])
            c2 = _nz_str(w2[j])
            if c1 != c2:
                u = _char_index(c1)
                v = _char_index(c2)
                edges[u][v] = True
                found_diff = True
                break
            j += 1
        if not found_diff and len(w1) > len(w2) and _has_prefix(w1, w2, min_len):
            return ""
        i += 1

    states = [0 for _ in range(26)]
    output: list[int] = []
    for node in present_order:
        if _dfs_visit(node, states, edges, present_order, output):
            return ""

    res = ""
    out_idx = len(output) - 1
    while out_idx >= 0:
        res += _index_char(_nz_int(output[out_idx]))
        out_idx -= 1
    return res

def main():
    assert alienOrder(['wrt', 'wrf', 'er', 'ett', 'rftt']) == 'wertf'
    assert alienOrder(['z', 'x']) == 'zx'
    assert alienOrder(['z', 'x', 'z']) == ''
