# LeetCode 322: Coin Change

def coinChange(coins: list[int], amount: int) -> Result[int, Error]:
    try:
        if amount < 0:
            return -1

        dp: list[int] = []
        for i in range(amount + 1):
            dp.append(amount + 1)
        dp[0] = 0

        for a in range(len(dp)):
            if a == 0:
                continue
            for c in coins:
                prev = a - c
                if prev >= 0 and prev < len(dp):
                    dp[a] = min(dp[a], 1 + dp[prev])

        if amount >= len(dp):
            return -1
        return dp[amount] if dp[amount] != amount + 1 else -1
    except Error as error:
        raise error

def main():
    try:
        coin_change_result_1: int = coinChange([1,2,5], 11)
        assert str(coin_change_result_1) == '3'
        coin_change_result_2: int = coinChange([2], 3)
        assert str(coin_change_result_2) == '-1'
        coin_change_result_3: int = coinChange([1], 0)
        assert str(coin_change_result_3) == '0'
    except Error:
        assert False
