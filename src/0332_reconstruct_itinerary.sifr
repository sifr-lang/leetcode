# LeetCode 332: Reconstruct Itinerary

def findItinerary(tickets: list[tuple[str, str]]) -> list[str]:
    ordered: list[tuple[str, str]] = tickets[:]
    ordered.sort()

    adj: dict[str, list[str]] = {}
    for ticket in ordered:
        src = ticket[0]
        dst = ticket[1]
        if src not in adj:
            adj[src] = []
        if src in adj:
            adj[src].append(dst)

    route: list[str] = []
    positions: dict[str, int] = {}
    stack: list[str] = ['JFK']
    while stack:
        src = stack.pop()
        if src not in adj:
            route.append(src)
            continue
        pos = positions.get(src, 0)
        if pos is None:
            pos = 0
        if pos >= len(adj[src]):
            route.append(src)
            continue
        stack.append(str(src))
        if src in adj:
            next_stop = adj[src][pos]
            positions[src] = pos + 1
            if next_stop is not None:
                stack.append(str(next_stop))

    route.reverse()
    if len(route) != len(tickets) + 1:
        return []
    return route

def main():
    assert findItinerary([('MUC', 'LHR'), ('JFK', 'MUC'), ('SFO', 'SJC'), ('LHR', 'SFO')]) == ['JFK', 'MUC', 'LHR', 'SFO', 'SJC']
    assert findItinerary([('JFK', 'SFO'), ('JFK', 'ATL'), ('SFO', 'ATL'), ('ATL', 'JFK'), ('ATL', 'SFO')]) == ['JFK', 'ATL', 'JFK', 'SFO', 'ATL', 'SFO']
