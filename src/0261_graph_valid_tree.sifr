from helpers.dsu import UnionFind

def validTreeDsu(n: int, edges: list[list[int]]) -> Result[bool, Error]:
    try:
        if n == 0:
            return True

        dsu = UnionFind(n)

        for edge in edges:
            a0 = edge[0]
            b0 = edge[1]
            a = 0
            b = 0
            if a0 is not None and b0 is not None:
                a = a0
                b = b0
            else:
                continue

            joined: bool = dsu.union(a, b)
            if not joined:
                return False

        return dsu.component_count() == 1
    except Error as error:
        raise error

# Canonical entrypoint for this fixture.
def validTree(n: int, edges: list[list[int]]) -> Result[bool, Error]:
    try:
        return validTreeDsu(n, edges)
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: bool = validTree(5, [[0, 1], [0, 2], [0, 3], [1, 4]])
        assert contract_result_1 == True
        contract_result_2: bool = validTree(5, [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]])
        assert contract_result_2 == False
        contract_result_3: bool = validTreeDsu(5, [[0, 1], [0, 2], [0, 3], [1, 4]])
        assert contract_result_3 == True
        contract_result_4: bool = validTreeDsu(5, [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]])
        assert contract_result_4 == False
    except Error:
        assert False
