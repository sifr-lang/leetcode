# LeetCode 1834: Single Threaded Cpu
from sifr.heapq import heappop, heappush
from helpers.safe_math import div_or_zero, mod_or_zero

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def getOrder(tasks: list[list[int]]) -> list[int]:
    jobs: list[tuple[int, int, int]] = []
    for i in range(len(tasks)):
        row = tasks[i]
        jobs.append((_nz_int(row[0]), _nz_int(row[1]), i))
    jobs.sort()

    n = len(jobs)
    heap: list[int] = []
    result: list[int] = []
    if n == 0:
        return result

    cur_task_index = 0
    cur_time = _nz_int(jobs[0][0])
    base = n + 1
    while len(result) < n:
        while cur_task_index < n and _nz_int(jobs[cur_task_index][0]) <= cur_time:
            proc = _nz_int(jobs[cur_task_index][1])
            orig = _nz_int(jobs[cur_task_index][2])
            heappush(heap, (proc * base) + orig)
            cur_task_index += 1

        if len(heap) > 0:
            item: int | None = heappop(heap)
            if item is not None:
                encoded: int = item
                proc2 = div_or_zero(encoded, base)
                orig2 = mod_or_zero(encoded, base)
                cur_time += proc2
                result.append(orig2)
        elif cur_task_index < n:
            cur_time = _nz_int(jobs[cur_task_index][0])

    return result

def main():
    assert getOrder([[1, 2], [2, 4], [3, 2], [4, 1]]) == [0, 2, 3, 1]
    assert getOrder([[7, 10], [7, 12], [7, 5], [7, 4], [7, 2]]) == [4, 3, 2, 0, 1]
