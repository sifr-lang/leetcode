# LeetCode 895: Maximum Frequency Stack

class FreqStack:
    cnt: dict[int, int]
    maxCnt: int
    stacks: dict[int, list[int]]

    def __init__(self):
        self.cnt = {}
        self.maxCnt = 0
        self.stacks = {}

    def push(mut self, val: int) -> None:
        valCnt = self.cnt.get(val, 0) + 1
        self.cnt[val] = valCnt

        if valCnt > self.maxCnt:
            self.maxCnt = valCnt

        if valCnt not in self.stacks:
            self.stacks[valCnt] = []

        if valCnt in self.stacks:
            self.stacks[valCnt].append(val)

    def pop(mut self) -> int:
        max_count = self.maxCnt
        if max_count in self.stacks:
            res_opt = self.stacks[max_count].pop()
            if res_opt is None:
                return 0
            res = res_opt

            current = self.cnt.get(res, 0)
            if current > 0:
                self.cnt[res] = current - 1

            if max_count in self.stacks and len(self.stacks[max_count]) == 0:
                self.maxCnt -= 1

            return res
        return 0


def main():
    obj = FreqStack()
    obj.push(5)
    obj.push(7)
    obj.push(5)
    obj.push(7)
    obj.push(4)
    obj.push(5)
    assert obj.pop() == 5
    assert obj.pop() == 7
    assert obj.pop() == 5
    assert obj.pop() == 4
