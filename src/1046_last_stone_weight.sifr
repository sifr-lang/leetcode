# LeetCode 1046: Last Stone Weight
from sifr.heapq import _heapify_max, _heappop_max, _heapreplace_max

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value

def lastStoneWeight(mut stones: list[int]) -> int:
    _heapify_max(stones)
    while len(stones) > 1:
        max_stone = unwrapInt(_heappop_max(stones))
        next_stone: int | None = stones[0]
        if next_stone is None:
            return max_stone
        diff = max_stone - next_stone
        if diff != 0:
            _heapreplace_max(stones, diff)
        else:
            _heappop_max(stones)

    if len(stones) == 0:
        return 0
    return unwrapInt(stones[0])

def main():
    assert lastStoneWeight([2, 7, 4, 1, 8, 1]) == 1
    assert lastStoneWeight([1]) == 1
