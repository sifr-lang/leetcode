# LeetCode 703: Kth Largest Element In A Stream
from sifr.heapq import heapify, heappop, heappush

class KthLargest:
    minHeap: list[int]
    k: int

    def __init__(self, k: int, nums: list[int]):
        self.k = k
        heap = nums
        heapify(heap)
        while len(heap) > k:
            heappop(heap)
        self.minHeap = heap

    def add(self, val: int) -> int:
        heap: list[int] = self.minHeap
        heappush(heap, val)
        if len(heap) > self.k:
            heappop(heap)
        kth: int | None = heap[0]
        self.minHeap = heap
        if kth is None:
            return val
        return kth

def main():
    obj = KthLargest(3, [4, 5, 8, 2])
    assert obj.add(3) == 4
    assert obj.add(5) == 5
    assert obj.add(10) == 5
    assert obj.add(9) == 8
    assert obj.add(4) == 8
