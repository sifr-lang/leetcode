# LeetCode 853: Car Fleet

from helpers.safe_math import ratio_or_zero

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def _nz_float(value: float | None) -> float:
    if value is None:
        return 0.0
    return value

def carFleet(target: int, position: list[int], speed: list[int]) -> Result[int, FloatOverflowError | FloatPrecisionLossError]:
    pair: list[tuple[int, int]] = []
    for i in range(len(position)):
        pair.append((_nz_int(position[i]), _nz_int(speed[i])))

    pair.sort()
    pair.reverse()

    stack: list[float] = []
    for p, s in pair:
        try:
            travel_time: float = ratio_or_zero(target - p, s)
        except FloatOverflowError as error:
            raise error
        except FloatPrecisionLossError as error:
            raise error
        stack.append(travel_time)
        if len(stack) >= 2 and _nz_float(stack[-1]) <= _nz_float(stack[-2]):
            stack.pop()
    return len(stack)

def main():
    try:
        fleets: int = carFleet(12, [10, 8, 0, 5, 3], [2, 4, 1, 1, 3])
        assert fleets == 3
    except Error:
        assert False
