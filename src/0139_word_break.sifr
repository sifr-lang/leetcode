# LeetCode 139: Word Break

def wordBreak(s: str, wordDict: list[str]) -> Result[bool, Error]:
    try:

        dp = [False] * (len(s) + 1)
        dp[len(s)] = True

        for i in range(len(s) - 1, -1, -1):
            for w in wordDict:
                if (i + len(w)) <= len(s) and s[i : i + len(w)] == w:
                    next_ok = dp[i + len(w)]
                    if next_ok is not None and next_ok:
                        dp[i] = True
                curr = dp[i]
                if curr is not None and curr:
                    break

        result = dp[0]
        if result is not None:
            return result
        return False
    except Error as error:
        raise error

def main():
    try:
        word_break_result_1: bool = wordBreak("leetcode", ["leet","code"])
        assert str(word_break_result_1) == 'true'
        word_break_result_2: bool = wordBreak("applepenapple", ["apple","pen"])
        assert str(word_break_result_2) == 'true'
    except Error:
        assert False
