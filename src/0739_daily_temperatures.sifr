# LeetCode 739: Daily Temperatures

def dailyTemperatures(temperatures: list[int]) -> Result[list[int], Error]:
    try:
        res = [0] * len(temperatures)
        stack: list[tuple[int, int]] = []

        for i, t in enumerate(temperatures):
            while stack and t > stack[-1][0]:
                pair: tuple[int, int] | None = stack.pop()
                if pair is None:
                    break
                stackInd = pair[1]
                res[stackInd] = i - stackInd
            stack.append((t, i))
        return res
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: list[int] = dailyTemperatures([73,74,75,71,69,72,76,73])
        assert str(contract_result_1) == '[1, 1, 4, 2, 1, 1, 0, 0]'
    except Error:
        assert False
