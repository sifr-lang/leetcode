# LeetCode 473: Matchsticks To Square

def makesquare(mut matchsticks: list[int]) -> Result[bool, Error]:
    try:
        total = sum(matchsticks)
        if (total % 4) != 0:
            return False

        length = total // 4
        sides = [0, 0, 0, 0]
        matchsticks.sort()
        matchsticks.reverse()

        def backtrack(i: int) -> Result[bool, Error]:
            try:
                if i == len(matchsticks):
                    side0 = sides[0]
                    side1 = sides[1]
                    side2 = sides[2]
                    side3 = sides[3]
                    if side0 is None or side1 is None or side2 is None or side3 is None:
                        return False
                    return side0 == length and side1 == length and side2 == length and side3 == length

                stick_raw = matchsticks[i]
                stick = 0
                if stick_raw is not None:
                    stick = stick_raw
                else:
                    return False

                for j in range(4):
                    side_raw = sides[j]
                    side = 0
                    if side_raw is not None:
                        side = side_raw
                    else:
                        continue
                    if side + stick <= length:
                        sides[j] = side + stick
                        completed: bool = backtrack(i + 1)
                        if completed:
                            return True
                        side_raw = sides[j]
                        if side_raw is not None:
                            side = side_raw
                        else:
                            return False
                        sides[j] = side - stick
                return False
            except Error as error:
                raise error

        return backtrack(0)
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: bool = makesquare([1, 1, 2, 2, 2])
        assert contract_result_1 == True
        contract_result_2: bool = makesquare([3, 3, 3, 3, 4])
        assert contract_result_2 == False
    except Error:
        assert False
