# LeetCode 380: Insert Delete Getrandom O1

def choice(values: list[int]) -> int:
    value: int | None = values[0]
    if value is not None:
        return value
    return 0


def lastValue(values: list[int]) -> int:
    if len(values) == 0:
        return 0
    value: int | None = values[len(values) - 1]
    if value is not None:
        return value
    return 0


class RandomizedSet:
    indexMap: dict[int, int]
    values: list[int]

    def __init__(self):
        self.indexMap = {}
        self.values = []

    def insert(mut self, val: int) -> bool:
        if self.indexMap.get(val, -1) != -1:
            return False
        self.indexMap[val] = len(self.values)
        self.values.append(val)
        return True

    def remove(mut self, val: int) -> Result[bool, Error]:
        try:
            idx = self.indexMap.get(val, -1)
            if idx == -1:
                return False
            lastElement = lastValue(self.values)
            self.values[idx] = lastElement
            self.indexMap[lastElement] = idx
            self.values.pop()
            self.indexMap[val] = -1
            return True
        except Error as error:
            raise error

    def getRandom(self) -> int:
        return choice(self.values)


def main():
    try:
        randomizedSet = RandomizedSet()
        assert randomizedSet.insert(1) == True
        remove_result_1: bool = randomizedSet.remove(2)
        assert remove_result_1 == False
        assert randomizedSet.insert(2) == True
        assert randomizedSet.getRandom() == 1
        remove_result_2: bool = randomizedSet.remove(1)
        assert remove_result_2 == True
        assert randomizedSet.insert(2) == False
        assert randomizedSet.getRandom() == 2
    except Error:
        assert False
