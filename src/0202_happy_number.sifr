# LeetCode 202: Happy Number

def isHappy(n: int) -> Result[bool, Error]:
    try:
        slow = n
        fast: int = sumSquareDigits(n)

        while slow != fast:
            updated_contract_value_1: int = sumSquareDigits(fast)
            fast = updated_contract_value_1
            updated_contract_value_2: int = sumSquareDigits(fast)
            fast = updated_contract_value_2
            updated_contract_value_3: int = sumSquareDigits(slow)
            slow = updated_contract_value_3

        return True if fast == 1 else False
    except Error as error:
        raise error


def sumSquareDigits(mut n: int) -> Result[int, Error]:
    try:
        output = 0
        while n != 0:
            square: int = (n % 10) ** 2
            output += square
            n = n // 10
        return output
    except Error as error:
        raise error

def main():
    try:
        is_happy_result_1: bool = isHappy(19)
        assert str(is_happy_result_1) == 'true'
        is_happy_result_2: bool = isHappy(2)
        assert str(is_happy_result_2) == 'false'
    except Error:
        assert False
