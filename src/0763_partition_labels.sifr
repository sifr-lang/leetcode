# LeetCode 763: Partition Labels

def partitionLabels(S: str) -> Result[list[int], Error]:
    try:
        count: dict[str, int] = {}
        res: list[int] = []
        i, length = 0, len(S)
        for j in range(length):
            c = S[j]
            count[c] = j

        curLen = 0
        goal = 0
        while i < length:
            c = S[i]
            if c is None:
                raise IndexError("partition index out of bounds")
            goal = max(goal, count.get(c, i))
            curLen += 1

            if goal == i:
                res.append(curLen)
                curLen = 0
            i += 1
        return res
    except Error as error:
        raise error

def main():
    try:
        partition_labels_result_1: list[int] = partitionLabels("ababcbacadefegdehijhklij")
        assert str(partition_labels_result_1) == '[9, 7, 8]'
    except Error:
        assert False
