# LeetCode 201: Bitwise And Of Numbers Range

def rangeBitwiseAnd(mut left: int, mut right: int) -> int:
    i = 0
    while left != right:
        left = left >> 1
        right = right >> 1
        i += 1
    return left << i

def main():
    assert rangeBitwiseAnd(5, 7) == 4
    assert rangeBitwiseAnd(0, 0) == 0
    assert rangeBitwiseAnd(1, 2147483647) == 0
