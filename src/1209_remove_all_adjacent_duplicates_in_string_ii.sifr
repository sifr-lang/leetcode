# LeetCode 1209: Remove All Adjacent Duplicates In String Ii

def removeDuplicates(s: str, k: int) -> str:
    if k <= 0:
        return "" + s
    stack: list[tuple[str, int]] = []

    for c in s:
        if len(stack) > 0:
            top: tuple[str, int] | None = stack.pop()
            if top is None:
                stack.append((c, 1))
            else:
                if top[0] == c:
                    count = top[1] + 1
                    if count != k:
                        stack.append((c, count))
                else:
                    stack.append(top)
                    stack.append((c, 1))
        else:
            stack.append((c, 1))

    res = ""
    for char, count in stack:
        res = res + (char * count)
    return res

def main():
    assert str(removeDuplicates("abcd", 2)) == 'abcd'
    assert str(removeDuplicates("deeedbbcccbdaa", 3)) == 'aa'
