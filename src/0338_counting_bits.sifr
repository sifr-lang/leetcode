# LeetCode 338: Counting Bits

def countBits(n: int) -> Result[list[int], Error]:
    try:
        dp = [0] * (n + 1)
        offset = 1

        for i in range(1, n + 1):
            if offset * 2 == i:
                offset = i
            prev = dp[i - offset]
            if prev is None:
                dp[i] = 1
            else:
                dp[i] = 1 + prev
        return dp
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: list[int] = countBits(2)
        assert str(contract_result_1) == '[0, 1, 1]'
        contract_result_2: list[int] = countBits(5)
        assert str(contract_result_2) == '[0, 1, 1, 2, 1, 2]'
    except Error:
        assert False
