# LeetCode 1472: Design Browser History

class BrowserHistory:    
    def __init__(self, homepage: str):
        self.i = 0
        self.len = 1
        self.history = [homepage]
    def visit(mut self, own url: str) -> Result[None, Error]:
        try:
            if len(self.history) < self.i + 2:
                self.history.append(str(url))
            else:
                self.history[self.i + 1] = str(url)
            self.i += 1
            self.len = self.i + 1
            return None
        except Error as error:
            raise error
    def back(mut self, steps: int) -> str:
        self.i = max(self.i - steps, 0)
        page: str | None = self.history[self.i]
        if page is not None:
            return page
        return ""
    def forward(mut self, steps: int) -> str:
        self.i = min(self.i + steps, self.len - 1)
        page: str | None = self.history[self.i]
        if page is not None:
            return page
        return ""

def main():
    try:
        obj = BrowserHistory('leetcode.com')
        visit_completion_1: None = obj.visit('google.com')
        visit_completion_2: None = obj.visit('facebook.com')
        visit_completion_3: None = obj.visit('youtube.com')
        assert obj.back(1) == 'facebook.com'
        assert obj.back(1) == 'google.com'
        assert obj.forward(1) == 'facebook.com'
        visit_completion_4: None = obj.visit('linkedin.com')
        assert obj.forward(2) == 'linkedin.com'
        assert obj.back(2) == 'google.com'
        assert obj.back(7) == 'leetcode.com'
    except Error:
        assert False
