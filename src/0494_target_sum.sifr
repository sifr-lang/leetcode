# LeetCode 494: Target Sum

def findTargetSumWays(nums: list[int], target: int) -> Result[int, Error]:
    try:
        dp = {}  # (index, total) -> # of ways

        def backtrack(i, total) -> Result[int, Error]:
            try:
                if i == len(nums):
                    return 1 if total == target else 0
                if (i, total) in dp:
                    return dp[(i, total)]

                positive_value = nums[i]
                if positive_value is None:
                    raise IndexError("target-sum index out of bounds")
                positive: int = backtrack(i + 1, total + positive_value)
                negative_value = nums[i]
                if negative_value is None:
                    raise IndexError("target-sum index out of bounds")
                negative: int = backtrack(i + 1, total - negative_value)
                dp[(i, total)] = positive + negative
                cached = dp[(i, total)]
                if cached is None:
                    raise KeyError("target-sum cache entry is absent")
                return cached
            except Error as error:
                raise error

        return backtrack(0, 0)
    except Error as error:
        raise error

def main():
    try:
        find_target_sum_ways_result_1: int = findTargetSumWays([1,1,1,1,1], 3)
        assert str(find_target_sum_ways_result_1) == '5'
    except Error:
        assert False
