# LeetCode 211: Design Add And Search Words Data Structure

def _child(edges: list[dict[str, int]], node: int, ch: str) -> int:
    row: dict[str, int] | None = edges[node]
    if row is None:
        return -1
    return row.get(ch, -1)

def _terminal(end: list[bool], node: int) -> bool:
    value: bool | None = end[node]
    if value is None:
        return False
    return value

def _search_from(edges: list[dict[str, int]], end: list[bool], pattern: str, index: int, node: int) -> bool:
    if index == len(pattern):
        return _terminal(end, node)

    ch: str | None = pattern[index]
    if ch is None:
        return False

    if ch == ".":
        row: dict[str, int] | None = edges[node]
        if row is not None:
            for child in row.values():
                if _search_from(edges, end, pattern, index + 1, child):
                    return True
        return False

    next_node = _child(edges, node, ch)
    if next_node == -1:
        return False
    return _search_from(edges, end, pattern, index + 1, next_node)

class WordDictionary:
    edges: list[dict[str, int]]
    end: list[bool]

    def __init__(self):
        self.edges = [{}]
        self.end = [False]

    def addWord(self, word: str) -> None:
        node = 0
        for ch in word:
            next_node = _child(self.edges, node, ch)
            if next_node == -1:
                next_node = len(self.edges)
                row: dict[str, int] | None = self.edges[node]
                if row is not None:
                    row[ch] = next_node
                    self.edges[node] = row
                self.edges.append({})
                self.end.append(False)
            node = next_node
        self.end[node] = True

    def search(self, pattern: str) -> bool:
        return _search_from(self.edges, self.end, pattern, 0, 0)

def main():
    obj2 = WordDictionary()
    obj2.addWord('aaa')
    assert obj2.search('aaa') == True
    assert obj2.search('.aa') == True
    obj2.addWord('baa')
    assert obj2.search('baa') == True

    obj = WordDictionary()
    obj.addWord('bad')
    obj.addWord('dad')
    obj.addWord('mad')
    obj.addWord('aaa')
    obj.addWord('baa')
    assert obj.search('aaa') == True
    assert obj.search('.aa') == True
    assert obj.search('baa') == True
    assert obj.search('pad') == False
    assert obj.search('bad') == True
    assert obj.search('.ad') == True
    assert obj.search('b..') == True
