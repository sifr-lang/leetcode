# LeetCode 1260: Shift 2D Grid

from helpers.safe_math import div_or_zero, mod_or_zero

def shiftGrid(grid: list[list[int]], k: int) -> Result[list[list[int]], Error]:
    try:
        M = len(grid)
        if M <= 0:
            return []
        first_row: list[int] | None = grid[0]
        if first_row is None:
            return []
        N = len(first_row)
        if N <= 0:
            return []
    
        def posToVal(r, c):
            return r * N + c
        def valToPos(v):
            return [div_or_zero(v, N), mod_or_zero(v, N)]
    
        res = [[0] * N for i in range(M)]
        for r in range(M):
            for c in range(N):
                newVal = mod_or_zero(posToVal(r, c) + k, M * N)
                pos = valToPos(newVal)
                newR = pos[0]
                newC = pos[1]
                if newR is None or newC is None:
                    raise IndexError("shift position is missing")
                value = grid[r][c]
                if value is None:
                    raise IndexError("grid cell is missing")
                res[newR][newC] = value
        return res
    except Error as error:
        raise error

def main():
    try:
        shift_grid_result_1: list[list[int]] = shiftGrid([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1)
        assert shift_grid_result_1 == [[9, 1, 2], [3, 4, 5], [6, 7, 8]]
        shift_grid_result_2: list[list[int]] = shiftGrid([[3, 8, 1, 9], [19, 7, 2, 5], [4, 6, 11, 10], [12, 0, 21, 13]], 4)
        assert shift_grid_result_2 == [[12, 0, 21, 13], [3, 8, 1, 9], [19, 7, 2, 5], [4, 6, 11, 10]]
        shift_grid_result_3: list[list[int]] = shiftGrid([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 9)
        assert shift_grid_result_3 == [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    except Error:
        assert False
