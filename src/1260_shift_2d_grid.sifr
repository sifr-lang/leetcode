# LeetCode 1260: Shift 2D Grid

from helpers.safe_math import div_or_zero, mod_or_zero

def shiftGrid(grid: list[list[int]], k: int) -> list[list[int]]:
    M = len(grid)
    if M <= 0:
        return []
    first_row: list[int] | None = grid[0]
    if first_row is None:
        return []
    N = len(first_row)
    if N <= 0:
        return []
    
    def posToVal(r, c):
        return r * N + c
    def valToPos(v):
        return [div_or_zero(v, N), mod_or_zero(v, N)]
    
    res = [[0] * N for i in range(M)]
    for r in range(M):
        for c in range(N):
            newVal = mod_or_zero(posToVal(r, c) + k, M * N)
            pos = valToPos(newVal)
            newR = pos[0]
            newC = pos[1]
            res[newR][newC] = grid[r][c]
    return res

def main():
    assert shiftGrid([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 1) == [[9, 1, 2], [3, 4, 5], [6, 7, 8]]
    assert shiftGrid([[3, 8, 1, 9], [19, 7, 2, 5], [4, 6, 11, 10], [12, 0, 21, 13]], 4) == [[12, 0, 21, 13], [3, 8, 1, 9], [19, 7, 2, 5], [4, 6, 11, 10]]
    assert shiftGrid([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 9) == [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
