# LeetCode 76: Minimum Window Substring

def minWindow(s: str, t: str) -> Result[str, Error]:
    try:
        if len(s) < len(t):
            return ""

        countT: dict[str, int] = {}
        window: dict[str, int] = {}
        for c in t:
            prev_count = countT.get(c, 0)
            if prev_count is None:
                prev_count = 0
            countT[c] = prev_count + 1

        have, need = 0, len(countT)
        res = [-1, -1]
        resLen = len(s) + 1
        l = 0
        for r in range(len(s)):
            c = s[r]
            if c is None:
                raise IndexError("window end out of bounds")
            prev_window = window.get(c, 0)
            if prev_window is None:
                prev_window = 0
            next_window = prev_window + 1
            window[c] = next_window

            need_count = countT.get(c, 0)
            if need_count is None:
                need_count = 0
            if c in countT and next_window == need_count:
                have = have + 1

            while have == need:
                # update our result
                if (r - l + 1) < resLen:
                    res = [l, r]
                    resLen = r - l + 1
                # pop from the left of our window
                left_char = s[l]
                if left_char is None:
                    raise IndexError("window start out of bounds")
                left_count = window.get(left_char, 0)
                if left_count is None:
                    left_count = 0
                new_left_count = left_count - 1
                window[left_char] = new_left_count
                left_need = countT.get(left_char, 0)
                if left_need is None:
                    left_need = 0
                if left_char in countT and new_left_count < left_need:
                    have = have - 1
                l = l + 1
        if resLen == len(s) + 1:
            return ""
        left_idx = res[0]
        if left_idx is not None:
            right_idx = res[1]
            if right_idx is not None:
                return s[left_idx : right_idx + 1]
        return ""
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: str = minWindow('ADOBECODEBANC', 'ABC')
        assert contract_result_1 == 'BANC'
        contract_result_2: str = minWindow('a', 'a')
        assert contract_result_2 == 'a'
        contract_result_3: str = minWindow('a', 'aa')
        assert contract_result_3 == ''
    except Error:
        assert False
