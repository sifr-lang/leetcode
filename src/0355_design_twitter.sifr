# LeetCode 355: Design Twitter
from sifr.heapq import heappop, heappush
from helpers.safe_math import div_or_zero, mod_or_zero

def unwrapTweet(value: tuple[int, int] | None) -> tuple[int, int]:
    if value is None:
        return (0, 0)
    return value


class Twitter:
    count: int
    tweetMap: dict[int, list[tuple[int, int]]]
    followMap: dict[int, list[int]]

    def __init__(self):
        self.count = 0
        self.tweetMap = {}
        self.followMap = {}

    def postTweet(self, userId: int, tweetId: int) -> None:
        tweets = self.tweetMap.get(userId, [])
        tweets.append((self.count, tweetId))
        self.tweetMap[userId] = tweets
        self.count -= 1

    def _tweetAt(self, userId: int, index: int) -> tuple[int, int]:
        tweets = self.tweetMap.get(userId, [])
        return unwrapTweet(tweets[index])

    def getNewsFeed(self, userId: int) -> list[int]:
        user_follows = self.followMap.get(userId, [])
        if userId not in user_follows:
            user_follows.append(userId)
            self.followMap[userId] = user_follows

        follows = self.followMap.get(userId, [])

        heap: list[int] = []
        base = 20_001
        offset = 100_000
        for followeeId in follows:
            tweets = self.tweetMap.get(followeeId, [])
            if len(tweets) > 0:
                index = len(tweets) - 1
                count, _tweet_id = self._tweetAt(followeeId, index)
                key = ((count + offset) * base * base) + (followeeId * base) + index
                heappush(heap, key)

        res: list[int] = []
        while len(res) < 10 and len(heap) > 0:
            item: int | None = heappop(heap)
            if item is not None:
                encoded: int = item
                position = mod_or_zero(encoded, base * base)
                followeeId = div_or_zero(position, base)
                index = mod_or_zero(position, base)
                count, tweet_id = self._tweetAt(followeeId, index)

                res.append(tweet_id)
                next_index = index - 1
                if next_index >= 0:
                    next_count, _next_tweet_id = self._tweetAt(followeeId, next_index)
                    next_key = ((next_count + offset) * base * base) + (followeeId * base) + next_index
                    heappush(heap, next_key)

        return res

    def follow(self, followerId: int, followeeId: int) -> None:
        user_follows = self.followMap.get(followerId, [])
        if followeeId not in user_follows:
            user_follows.append(followeeId)
            self.followMap[followerId] = user_follows

    def unfollow(self, followerId: int, followeeId: int) -> None:
        follows = self.followMap.get(followerId, [])
        filtered: list[int] = []
        for fid in follows:
            if fid != followeeId:
                filtered.append(fid)
        self.followMap[followerId] = filtered


def main():
    obj = Twitter()
    obj.postTweet(1, 5)
    assert obj.getNewsFeed(1) == [5]
    obj.postTweet(1, 7)
    assert obj.getNewsFeed(1) == [7, 5]
    obj.follow(1, 2)
    obj.postTweet(2, 6)
    assert obj.getNewsFeed(1) == [6, 7, 5]
    obj.unfollow(1, 2)
    assert obj.getNewsFeed(1) == [7, 5]
