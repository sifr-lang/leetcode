# LeetCode 424: Longest Repeating Character Replacement

def characterReplacement(s: str, k: int) -> Result[int, Error]:
    try:
        count: dict[str, int] = {}
    
        l = 0
        maxf = 0
        best = 0
        for r in range(len(s)):
            ch = s[r]
            if ch is None:
                raise IndexError("window end out of bounds")
            current_count = 1 + count.get(ch, 0)
            count[ch] = current_count
            if current_count > maxf:
                maxf = current_count

            while (r - l + 1) - maxf > k:
                left = s[l]
                if left is None:
                    raise IndexError("window start out of bounds")
                left_count = count.get(left, 0)
                count[str(left)] = left_count - 1
                l += 1
            window = r - l + 1
            if window > best:
                best = window

        return best
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: int = characterReplacement("ABAB", 2)
        assert str(contract_result_1) == '4'
        contract_result_2: int = characterReplacement("AABABBA", 1)
        assert str(contract_result_2) == '4'
    except Error:
        assert False
