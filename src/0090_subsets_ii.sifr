# LeetCode 90: Subsets Ii

def subsetsWithDup(mut nums: list[int]) -> Result[list[list[int]], Error]:
    try:
        res: list[list[int]] = []
        nums.sort()

        def backtrack(i: int, subset: list[int]) -> Result[None, Error]:
            try:
                if i >= len(nums):
                    res.append(subset.copy())
                    return

                # All subsets that include nums[i]
                current = nums[i]
                if current is None:
                    raise IndexError("subset index out of bounds")
                subset.append(current)
                backtracking_search_completion_2: None = backtrack(i + 1, subset)
                subset.pop()
                # All subsets that don't include nums[i]
                j = i
                while j + 1 < len(nums):
                    next_value = nums[j + 1]
                    if current != next_value:
                        break
                    j += 1
                backtracking_search_completion_3: None = backtrack(j + 1, subset)
                return None
            except Error as error:
                raise error

        backtracking_search_completion_1: None = backtrack(0, [])
        return res
    except Error as error:
        raise error

def main():
    try:
        subsets_with_dup_result_4: list[list[int]] = subsetsWithDup([1,2,2])
        assert str(subsets_with_dup_result_4) == '[[1, 2, 2], [1, 2], [1], [2, 2], [2], []]'
    except Error:
        assert False
