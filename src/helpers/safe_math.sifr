def div_or_zero(a: int, b: int) -> int:
    if b == 0:
        return 0
    try:
        value: int = a // b
        return value
    except DivisionError:
        return 0


def mod_or_zero(a: int, b: int) -> int:
    if b == 0:
        return 0
    try:
        value: int = a % b
        return value
    except DivisionError:
        return 0


def ceil_div_positive_or_zero(a: int, b: int) -> int:
    if a <= 0 or b <= 0:
        return 0
    return div_or_zero(a + b - 1, b)


def trunc_div_toward_zero_or_zero(a: int, b: int) -> int:
    if b == 0:
        return 0
    sign: int = 1
    numerator: int = a
    denominator: int = b
    if numerator < 0:
        numerator = -numerator
        sign = -sign
    if denominator < 0:
        denominator = -denominator
        sign = -sign
    quotient: int = div_or_zero(numerator, denominator)
    return quotient * sign


def ratio_or_zero(a: int, b: int) -> Result[float, FloatOverflowError | FloatPrecisionLossError]:
    if b == 0:
        return 0.0
    try:
        numerator: float = float(a)
        denominator: float = float(b)
        return numerator / denominator
    except FloatOverflowError as error:
        raise error
    except FloatPrecisionLossError as error:
        raise error


def main():
    assert div_or_zero(9, 2) == 4
    assert div_or_zero(9, 0) == 0
    assert mod_or_zero(9, 2) == 1
    assert mod_or_zero(9, 0) == 0
    assert trunc_div_toward_zero_or_zero(-9, 2) == -4
    assert ceil_div_positive_or_zero(9, 2) == 5
    try:
        ratio: float = ratio_or_zero(9, 2)
        assert ratio == 4.5
        zero_divisor: float = ratio_or_zero(9, 0)
        assert zero_divisor == 0.0
    except Error:
        assert False
    try:
        inexact: float = ratio_or_zero(9007199254740993, 1)
        _ = inexact
        assert False
    except FloatPrecisionLossError:
        pass
    except Error:
        assert False
