class UnionFind:
    parent: list[int]
    size: list[int]
    components: int

    def __init__(self, n: int) -> None:
        count: int = n
        if count < 0:
            count = 0
        self.parent = [i for i in range(count)]
        self.size = [1] * count
        self.components = count

    def find(self, x: int) -> int:
        if x < 0 or x >= len(self.parent):
            return x
        cur: int = x
        done: bool = False
        steps: int = 0
        limit: int = len(self.parent) + 1
        while not done and steps < limit:
            next_parent: int | None = self.parent[cur]
            if next_parent is None:
                return cur
            if next_parent == cur:
                done = True
            elif next_parent < 0 or next_parent >= len(self.parent):
                return cur
            else:
                grand_parent: int | None = self.parent[next_parent]
                if grand_parent is not None:
                    self.parent[cur] = grand_parent
                cur = next_parent
            steps = steps + 1
        return cur

    def union(self, x: int, y: int) -> bool:
        if x < 0 or y < 0:
            return False
        if x >= len(self.parent) or y >= len(self.parent):
            return False

        root_x: int = self.find(x)
        root_y: int = self.find(y)
        if root_x == root_y:
            return False

        size_x: int | None = self.size[root_x]
        size_y: int | None = self.size[root_y]
        if size_x is None or size_y is None:
            return False

        if size_x < size_y:
            self.parent[root_x] = root_y
            self.size[root_y] = size_x + size_y
        else:
            self.parent[root_y] = root_x
            self.size[root_x] = size_x + size_y
        self.components = self.components - 1
        return True

    def connected(self, x: int, y: int) -> bool:
        if x < 0 or y < 0:
            return False
        if x >= len(self.parent) or y >= len(self.parent):
            return False
        return self.find(x) == self.find(y)

    def component_count(self) -> int:
        return self.components
