class ListNode:
    val: int
    next: ListNode | None

    def __init__(self, val: int = 0, next: ListNode | None = None):
        self.val = val
        self.next = next


def nodeVal(node: ListNode | None) -> int:
    if node is None:
        return 0
    return node.val


def nodeNext(own node: ListNode | None) -> ListNode | None:
    if node is None:
        return None
    return node.next


def hasNode(node: ListNode | None) -> bool:
    return node is not None


def listNodeToString(own node: ListNode | None) -> str:
    parts: list[str] = []
    cur: ListNode | None = node
    while hasNode(cur):
        next_cur: ListNode | None = None
        if cur is not None:
            value: int = cur.val
            next_cur = cur.next
            parts.append(str(value))
        else:
            break
        cur = next_cur
    if len(parts) == 0:
        return "None"
    return "->".join(parts)
