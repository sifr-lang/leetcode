# LeetCode 309: Best Time To Buy And Sell Stock With Cooldown

def maxProfit(prices: list[int]) -> Result[int, Error]:
    try:
        if len(prices) == 0:
            return 0

        hold = -prices[0]
        sold = 0
        rest = 0
        i = 1
        while i < len(prices):
            price = prices[i]
            if price is None:
                raise IndexError("price index out of bounds")
            prev_sold = sold
            sold = hold + price
            hold = max(hold, rest - price)
            rest = max(rest, prev_sold)
            i += 1

        return max(sold, rest)
    except Error as error:
        raise error

def main():
    try:
        max_profit_result_1: int = maxProfit([1,2,3,0,2])
        assert str(max_profit_result_1) == '3'
        max_profit_result_2: int = maxProfit([1])
        assert str(max_profit_result_2) == '0'
    except Error:
        assert False
