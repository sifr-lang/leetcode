# LeetCode 496: Next Greater Element I

def nextGreaterElement(nums1: list[int], nums2: list[int]) -> list[int]:
    nums1_idx: dict[int, int] = {}
    res: list[int] = []
    i = 0
    while i < len(nums1):
        value: int = nums1[i]
        nums1_idx[value] = i
        res.append(-1)
        i += 1

    stack: list[int] = []
    for cur in nums2:
        while len(stack) > 0:
            top_opt: int | None = stack[len(stack) - 1]
            top: int = 0
            if top_opt is not None:
                top = top_opt
            else:
                break
            if cur <= top:
                break
            val_opt: int | None = stack.pop()
            val: int = 0
            if val_opt is not None:
                val = val_opt
            else:
                break
            idx_opt: int | None = nums1_idx[val]
            if idx_opt is not None:
                idx: int = idx_opt
                res[idx] = cur

        if cur in nums1_idx:
            stack.append(cur)
    return res

def main():
    assert str(nextGreaterElement([4, 1, 2], [1, 3, 4, 2])) == '[-1, 3, -1]'
    assert str(nextGreaterElement([2, 4], [1, 2, 3, 4])) == '[3, -1]'
