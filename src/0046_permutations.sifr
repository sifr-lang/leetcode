# LeetCode 46: Permutations

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value

def permute(mut nums: list[int]) -> list[list[int]]:
    res = []

    if len(nums) == 1:
        return [nums[:]]

    for i in range(len(nums)):
        n = unwrapInt(nums.pop(0))
        perms = permute(nums)

        for j in range(len(perms)):
            perm = perms[j]
            if perm is not None:
                perm.append(n)
                res.append(perm)
        nums.append(n)
    return res

def main():
    assert str(permute([1,2,3])) == '[[3, 2, 1], [2, 3, 1], [1, 3, 2], [3, 1, 2], [2, 1, 3], [1, 2, 3]]'
