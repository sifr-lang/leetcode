# LeetCode 119: Pascal Triangle Ii

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value

def getRow(rowIndex: int) -> list[int]:
    Memo: dict[int, list[int]] = {}

    def buildRow(index: int) -> list[int]:
        if index in Memo:
            cached = Memo[index]
            if cached is None:
                return []
            return cached
        if index == 0:
            return [1]

        ListPrec = buildRow(index - 1)
        Result = [1]
        for i in range(0, len(ListPrec) - 1):
            Result.append(unwrapInt(ListPrec[i]) + unwrapInt(ListPrec[i + 1]))
        Result.append(1)
        Memo[index] = Result
        return Result

    return buildRow(rowIndex)

def main():
    assert str(getRow(3)) == '[1, 3, 3, 1]'
    assert str(getRow(0)) == '[1]'
