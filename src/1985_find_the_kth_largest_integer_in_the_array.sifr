# LeetCode 1985: Find The Kth Largest Integer In The Array
from sifr.heapq import heapify, heappop

def _parse_or_zero(value: str) -> int:
    try:
        parsed: int = int(value)
        return parsed
    except ParseError:
        return 0

def kthLargestNumber(nums: list[str], k: int) -> str:
    heap: list[int] = []
    for value in nums:
        heap.append(-_parse_or_zero(value))
    heapify(heap)

    count = 1
    while count < k:
        heappop(heap)
        count += 1

    selected: int | None = heap[0]
    if selected is None:
        return "0"
    return str(-selected)

def main():
    assert kthLargestNumber(['3', '6', '7', '10'], 4) == '3'
    assert kthLargestNumber(['2', '21', '12', '1'], 3) == '2'
    assert kthLargestNumber(['0', '0'], 2) == '0'
