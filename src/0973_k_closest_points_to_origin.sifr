# LeetCode 973: K Closest Points To Origin
from sifr.heapq import heapify, heappop
from helpers.safe_math import div_or_zero, mod_or_zero

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def kClosest(points: list[list[int]], k: int) -> list[list[int]]:
    heap: list[int] = []
    base = 200_001
    offset = 100_000
    for point in points:
        x = _nz_int(point[0])
        y = _nz_int(point[1])
        dist = (x * x) + (y * y)
        heap.append((dist * base * base) + ((x + offset) * base) + (y + offset))
    heapify(heap)

    res: list[list[int]] = []
    count = 0
    while count < k:
        item: int | None = heappop(heap)
        if item is None:
            break
        if item is not None:
            encoded: int = item
            x = mod_or_zero(div_or_zero(encoded, base), base) - offset
            y = mod_or_zero(encoded, base) - offset
            res.append([x, y])
            count += 1
    return res

def main():
    assert kClosest([[1, 3], [-2, 2]], 1) == [[-2, 2]]
    assert kClosest([[3, 3], [5, -1], [-2, 4]], 2) == [[3, 3], [-2, 4]]
