# LeetCode 209: Minimum Size Subarray Sum

def minSubArrayLen(target: int, nums: list[int]) -> Result[int, Error]:
    try:
        res = float('inf')
        l, total = 0, 0

        for r in range(len(nums)):
            total += nums[r]
            while total >= target:
                res = min(res, r - l + 1)
                left_value = nums[l]
                if left_value is None:
                    raise IndexError("window start out of bounds")
                total -= left_value
                l += 1
        return res if res != float('inf') else 0
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: int = minSubArrayLen(7, [2,3,1,2,4,3])
        assert str(contract_result_1) == '2'
        contract_result_2: int = minSubArrayLen(4, [1,4,4])
        assert str(contract_result_2) == '1'
        contract_result_3: int = minSubArrayLen(11, [1,1,1,1,1,1,1,1])
        assert str(contract_result_3) == '0'
    except Error:
        assert False
