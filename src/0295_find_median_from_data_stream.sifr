# LeetCode 295: Find Median From Data Stream
from sifr.heapq import heappush, heappop

class MedianFinder:
    small: list[int]
    large: list[int]

    def __init__(self):
        self.small = []
        self.large = []

    def addNum(mut self, num: int) -> None:
        large_top: int | None = self.large[0]
        if large_top is not None and num > large_top:
            heappush(self.large, num)
        else:
            heappush(self.small, -num)

        if len(self.small) > len(self.large) + 1:
            moved: int | None = heappop(self.small)
            if moved is not None:
                heappush(self.large, -moved)

        if len(self.large) > len(self.small) + 1:
            moved2: int | None = heappop(self.large)
            if moved2 is not None:
                heappush(self.small, -moved2)

    def findMedian(self) -> Result[float, Error]:
        try:
            if len(self.small) > len(self.large):
                small_top: int | None = self.small[0]
                if small_top is not None:
                    median: float = -small_top / 1.0
                    return median
                return 0.0
            if len(self.large) > len(self.small):
                large_top: int | None = self.large[0]
                if large_top is not None:
                    median: float = large_top / 1.0
                    return median
                return 0.0
            left: int | None = self.small[0]
            right: int | None = self.large[0]
            if left is not None and right is not None:
                median: float = (-left + right) / 2.0
                return median
            return 0.0
        except Error as error:
            raise error

def main():
    try:
        obj = MedianFinder()
        obj.addNum(1)
        obj.addNum(2)
        contract_result_1: float = obj.findMedian()
        assert contract_result_1 == 1.5
        obj.addNum(3)
        contract_result_2: float = obj.findMedian()
        assert contract_result_2 == 2.0
    except Error:
        assert False
