# LeetCode 1582: Special Positions In A Binary Matrix

def numSpecial(mat: list[list[int]]) -> Result[int, Error]:
    try:
        m = len(mat)
        n = len(mat[0])
        rowCount = [0] * m
        colCount = [0] * n
        res = 0
        for r in range(m):
            for c in range(n):
                if mat[r][c] == 1:
                    rowCount[r] += 1
                    colCount[c] += 1
        for r in range(m):
            for c in range(n):
                if mat[r][c] == 1 and rowCount[r] == 1 and colCount[c] == 1:
                    res += 1
        return res
    except Error as error:
        raise error

def main():
    try:
        contract_result_1: int = numSpecial([[1, 0, 0], [0, 0, 1], [1, 0, 0]])
        assert contract_result_1 == 1
        contract_result_2: int = numSpecial([[1, 0, 0], [0, 1, 0], [0, 0, 1]])
        assert contract_result_2 == 3
    except Error:
        assert False
