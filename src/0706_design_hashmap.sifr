# LeetCode 706: Design Hashmap

BUCKET_COUNT = 769

def makeBuckets() -> list[list[tuple[int, int]]]:
    buckets: list[list[tuple[int, int]]] = []
    for _i in range(BUCKET_COUNT):
        bucket: list[tuple[int, int]] = []
        buckets.append(bucket)
    return buckets

class MyHashMap:
    buckets: list[list[tuple[int, int]]]

    def __init__(self):
        self.buckets = makeBuckets()

    def hashcode(self, key: int) -> int:
        size = len(self.buckets)
        if size == 0:
            return 0
        index = key % size
        if index < 0:
            return index + size
        return index

    def put(mut self, key: int, value: int) -> Result[None, Error]:
        try:
            index = self.hashcode(key)
            bucket: list[tuple[int, int]] | None = self.buckets[index]
            if bucket is None:
                return

            next_bucket: list[tuple[int, int]] = []
            replaced = False
            for existing_key, existing_value in bucket:
                if existing_key == key:
                    next_bucket.append((key, value))
                    replaced = True
                else:
                    next_bucket.append((existing_key, existing_value))

            if not replaced:
                next_bucket.append((key, value))

            self.buckets[index] = next_bucket
            return None
        except Error as error:
            raise error

    def get(self, key: int) -> int:
        index = self.hashcode(key)
        bucket: list[tuple[int, int]] | None = self.buckets[index]
        if bucket is None:
            return -1
        for existing_key, existing_value in bucket:
            if existing_key == key:
                return existing_value
        return -1

    def remove(mut self, key: int) -> Result[None, Error]:
        try:
            index = self.hashcode(key)
            bucket: list[tuple[int, int]] | None = self.buckets[index]
            if bucket is None:
                return

            next_bucket: list[tuple[int, int]] = []
            for existing_key, existing_value in bucket:
                if existing_key != key:
                    next_bucket.append((existing_key, existing_value))

            self.buckets[index] = next_bucket
            return None
        except Error as error:
            raise error


def main():
    try:
        obj = MyHashMap()
        contract_result_1: None = obj.put(1, 1)
        contract_result_2: None = obj.put(2, 2)
        assert obj.get(1) == 1
        assert obj.get(3) == -1
        contract_result_3: None = obj.put(2, 1)
        assert obj.get(2) == 1
        contract_result_4: None = obj.remove(2)
        assert obj.get(2) == -1
        contract_result_5: None = obj.put(5, -1)
        assert obj.get(5) == -1
        contract_result_6: None = obj.put(5, 7)
        assert obj.get(5) == 7
        contract_result_7: None = obj.remove(5)
        assert obj.get(5) == -1
    except Error:
        assert False
