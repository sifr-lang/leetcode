# LeetCode 1498: Number Of Subsequences That Satisfy The Given Sum Condition

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value

def numSubseq(mut nums: list[int], target: int) -> Result[int, Error]:
    try:
        nums.sort()

        res = 0

        left, right = 0, len(nums) - 1
        while  left <= right:
            if (unwrapInt(nums[left]) + unwrapInt(nums[right])) > target:
                right -= 1
            else:
                combinations: int = 1 << (right - left)
                res += combinations
                left += 1
        return res % 1000000007
    except Error as error:
        raise error

def main():
    try:
        num_subseq_result_1: int = numSubseq([3, 5, 6, 7], 9)
        assert num_subseq_result_1 == 4
        num_subseq_result_2: int = numSubseq([3, 3, 6, 8], 10)
        assert num_subseq_result_2 == 6
        num_subseq_result_3: int = numSubseq([2, 3, 3, 4, 6, 7], 12)
        assert num_subseq_result_3 == 61
    except Error:
        assert False
