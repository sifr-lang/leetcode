# LeetCode 208: Implement Trie Prefix Tree

def _child(edges: list[dict[str, int]], node: int, ch: str) -> int:
    if ch in edges[node]:
        child: int | None = edges[node][ch]
        if child is not None:
            return child
    return -1

def _terminal(end: list[bool], node: int) -> bool:
    value: bool | None = end[node]
    if value is None:
        return False
    return value

class Trie:
    edges: list[dict[str, int]]
    end: list[bool]

    def __init__(self):
        self.edges = [{}]
        self.end = [False]

    def insert(mut self, word: str) -> Result[None, Error]:
        try:
            node = 0
            for ch in word:
                next_node = _child(self.edges, node, ch)
                if next_node == -1:
                    next_node = len(self.edges)
                    self.edges[node][ch] = next_node
                    self.edges.append({})
                    self.end.append(False)
                node = next_node
            self.end[node] = True
            return None
        except Error as error:
            raise error

    def search(self, word: str) -> bool:
        node = 0
        for ch in word:
            node = _child(self.edges, node, ch)
            if node == -1:
                return False
        return _terminal(self.end, node)

    def startsWith(self, prefix: str) -> bool:
        node = 0
        for ch in prefix:
            node = _child(self.edges, node, ch)
            if node == -1:
                return False
        return True

def main():
    try:
        obj = Trie()
        contract_result_1: None = obj.insert('apple')
        assert obj.search('apple') == True
        assert obj.search('app') == False
        assert obj.startsWith('app') == True
        contract_result_2: None = obj.insert('app')
        assert obj.search('app') == True
    except Error:
        assert False
