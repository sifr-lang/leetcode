# LeetCode 263: Ugly Number

from helpers.safe_math import div_or_zero, mod_or_zero

def isUgly(n: int) -> bool:
    value = n
    if value <= 0:
        return False
    
    for p in [2, 3, 5]:
        while mod_or_zero(value, p) == 0:
            value = div_or_zero(value, p)
    return value == 1

def main():
    assert str(isUgly(6)) == 'true'
    assert str(isUgly(1)) == 'true'
    assert str(isUgly(14)) == 'false'

