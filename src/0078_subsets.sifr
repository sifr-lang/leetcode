# LeetCode 78: Subsets

def subsets(nums: list[int]) -> Result[list[list[int]], Error]:
    try:
        res: list[list[int]] = []

        subset: list[int] = []

        def dfs(i: int) -> Result[None, Error]:
            try:
                if i >= len(nums):
                    res.append(subset.copy())
                    return
                # decision to include nums[i]
                current = nums[i]
                if current is None:
                    raise IndexError("subset index out of bounds")
                subset.append(current)
                depth_first_search_completion_2: None = dfs(i + 1)
                # decision NOT to include nums[i]
                subset.pop()
                depth_first_search_completion_3: None = dfs(i + 1)
                return None
            except Error as error:
                raise error

        depth_first_search_completion_1: None = dfs(0)
        return res
    except Error as error:
        raise error

def main():
    try:
        subsets_result_4: list[list[int]] = subsets([1,2,3])
        assert str(subsets_result_4) == '[[1, 2, 3], [1, 2], [1, 3], [1], [2, 3], [2], [3], []]'
    except Error:
        assert False
