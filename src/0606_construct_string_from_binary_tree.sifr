# LeetCode 606: Construct String From Binary Tree
from helpers.tree_node import TreeNode, treeToString

def tree2str(root: TreeNode | None) -> str:
    res: list[str] = []
    dfs(root, res)
    return "".join(res)

def dfs(node: TreeNode | None, mut res: list[str]) -> None:
    if node is None:
        return
    res.append(str(node.val))
    if node.left is None and node.right is None:
        return
    res.append("(")
    dfs(node.left, res)
    res.append(")")
    if node.right is not None:
        res.append("(")
        dfs(node.right, res)
        res.append(")")

def main():
    assert tree2str(TreeNode(1, TreeNode(2, TreeNode(4, None, None), None), TreeNode(3, None, None))) == '1(2(4))(3)'
    assert tree2str(TreeNode(1, TreeNode(2, None, TreeNode(4, None, None)), TreeNode(3, None, None))) == '1(2()(4))(3)'
