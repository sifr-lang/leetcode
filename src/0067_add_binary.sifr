# LeetCode 67: Add Binary

def addBinary(mut a: str, mut b: str) -> str:
    res = ""
    carry = 0

    i = len(a) - 1
    j = len(b) - 1
    while i >= 0 or j >= 0:
        bitA = 0
        if i >= 0:
            if a[i] == "1":
                bitA = 1
        bitB = 0
        if j >= 0:
            if b[j] == "1":
                bitB = 1

        total = bitA + bitB + carry
        char = str(total % 2)
        res = char + res
        carry = total // 2
        i -= 1
        j -= 1

    if carry != 0:
        res = "1" + res

    return res

def main():
    assert str(addBinary("11", "1")) == '100'
    assert str(addBinary("1010", "1011")) == '10101'
