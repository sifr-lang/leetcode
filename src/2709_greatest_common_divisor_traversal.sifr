# LeetCode 2709: Greatest Common Divisor Traversal

def unwrapInt(value: int | None) -> int:
    if value is None:
        return 0
    return value


def find(mut par: list[int], x: int) -> Result[int, Error]:
    try:
        cur = x
        while unwrapInt(par[cur]) != cur:
            parent = unwrapInt(par[cur])
            grand = unwrapInt(par[parent])
            par[cur] = grand
            cur = parent
        return cur
    except Error as error:
        raise error


def union(mut par: list[int], mut size: list[int], x: int, y: int) -> Result[int, Error]:
    try:
        px: int = find(par, x)
        py: int = find(par, y)
        if px == py:
            return 0

        sx = unwrapInt(size[px])
        sy = unwrapInt(size[py])
        if sx < sy:
            par[px] = py
            size[py] = sx + sy
        else:
            par[py] = px
            size[px] = sx + sy
        return 1
    except Error as error:
        raise error


def modValue(value: int, modulus: int) -> int:
    if modulus == 0:
        return 0
    return value % modulus


def divValue(value: int, divisor: int) -> int:
    if divisor == 0:
        return value
    return value // divisor


def canTraverseAllPairs(nums: list[int]) -> Result[bool, Error]:
    try:
        n = len(nums)
        par = [i for i in range(n)]
        size = [1] * n
        components = n

        factor_index: dict[int, int] = {}
        for i, value in enumerate(nums):
            cur = value
            f = 2
            while f * f <= cur:
                if modValue(cur, f) == 0:
                    if f in factor_index:
                        joined: int = union(par, size, i, factor_index.get(f, 0))
                        components -= joined
                    else:
                        factor_index[f] = i
                    while modValue(cur, f) == 0:
                        cur = divValue(cur, f)
                f += 1
            if cur > 1:
                if cur in factor_index:
                    joined: int = union(par, size, i, factor_index.get(cur, 0))
                    components -= joined
                else:
                    factor_index[cur] = i

        return components == 1
    except Error as error:
        raise error


def main():
    try:
        contract_result_1: bool = canTraverseAllPairs([2, 3, 6])
        assert contract_result_1 == True
        contract_result_2: bool = canTraverseAllPairs([3, 9, 5])
        assert contract_result_2 == False
        contract_result_3: bool = canTraverseAllPairs([4, 3, 12, 8])
        assert contract_result_3 == True
    except Error:
        assert False
