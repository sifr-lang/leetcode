# LeetCode 80: Remove Duplicates From Sorted Array Ii

def removeDuplicates(mut nums: list[int]) -> Result[int, Error]:
    try:
        l, r = 0, 0

        while r < len(nums):
            count = 1
            while r + 1 < len(nums) and nums[r] == nums[r + 1]:
                r += 1
                count += 1
        
            for i in range(min(2, count)):
                value: int | None = nums[r]
                if value is None:
                    raise IndexError("duplicate source index is out of range")
                nums[l] = value
                l += 1
            r += 1
        return l
    except Error as error:
        raise error

def main():
    try:
        remove_duplicates_result_1: int = removeDuplicates([1,1,1,2,2,3])
        assert str(remove_duplicates_result_1) == '5'
    except Error:
        assert False
