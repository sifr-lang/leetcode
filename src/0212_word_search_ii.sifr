# LeetCode 212: Word Search Ii

def _child(edges: list[dict[str, int]], node: int, ch: str) -> int:
    if ch in edges[node]:
        child: int | None = edges[node][ch]
        if child is not None:
            return child
    return -1

def _bool_at(values: list[bool], index: int) -> bool:
    value: bool | None = values[index]
    if value is None:
        return False
    return value

def _int_at(values: list[int], index: int) -> int:
    value: int | None = values[index]
    if value is None:
        return 0
    return value

class WordTrie:
    edges: list[dict[str, int]]
    terminal: list[bool]
    refs: list[int]

    def __init__(self):
        self.edges = [{}]
        self.terminal = [False]
        self.refs = [0]

    def insert(self, word: str) -> None:
        node = 0
        current_refs = _int_at(self.refs, node)
        self.refs[node] = current_refs + 1
        for ch in word:
            next_node = _child(self.edges, node, ch)
            if next_node == -1:
                next_node = len(self.edges)
                self.edges[node][ch] = next_node
                self.edges.append({})
                self.terminal.append(False)
                self.refs.append(0)
            node = next_node
            current_refs = _int_at(self.refs, node)
            self.refs[node] = current_refs + 1

        self.terminal[node] = True

    def removeWord(self, word: str) -> None:
        node = 0
        current_refs = _int_at(self.refs, node)
        self.refs[node] = current_refs - 1
        for ch in word:
            next_node = _child(self.edges, node, ch)
            if next_node == -1:
                break
            node = next_node
            current_refs = _int_at(self.refs, node)
            self.refs[node] = current_refs - 1

    def child(self, node: int, ch: str) -> int:
        return _child(self.edges, node, ch)

    def hasRefs(self, node: int) -> bool:
        return _int_at(self.refs, node) > 0

    def isWord(self, node: int) -> bool:
        return _bool_at(self.terminal, node)

    def clearWord(self, node: int) -> None:
        self.terminal[node] = False

def boardChar(board: list[list[str]], r: int, c: int) -> str | None:
    return board[r][c]

def collectWords(
    board: list[list[str]],
    rows: int,
    cols: int,
    mut trie: WordTrie,
    node: int,
    prefix: str,
    r: int,
    c: int,
    mut visit: set[tuple[int, int]],
    own mut found: dict[str, bool],
) -> dict[str, bool]:
    if r < 0 or c < 0 or r >= rows or c >= cols:
        return found
    if (r, c) in visit:
        return found

    letter: str | None = boardChar(board, r, c)
    if letter is None:
        return found

    next_node = trie.child(node, letter)
    if next_node == -1:
        return found
    if not trie.hasRefs(next_node):
        return found

    next_prefix: str = prefix + letter
    if trie.isWord(next_node):
        trie.clearWord(next_node)
        found[next_prefix] = True
        trie.removeWord(next_prefix)

    visit.add((r, c))
    found = collectWords(board, rows, cols, trie, next_node, next_prefix, r + 1, c, visit, found)
    found = collectWords(board, rows, cols, trie, next_node, next_prefix, r - 1, c, visit, found)
    found = collectWords(board, rows, cols, trie, next_node, next_prefix, r, c + 1, visit, found)
    found = collectWords(board, rows, cols, trie, next_node, next_prefix, r, c - 1, visit, found)
    visit.remove((r, c))
    return found

def findWords(board: list[list[str]], words: list[str]) -> list[str]:
    if len(board) == 0:
        return []
    first_row: list[str] | None = board[0]
    if first_row is None:
        return []
    if len(first_row) == 0:
        return []

    rows = len(board)
    cols = len(first_row)
    trie = WordTrie()
    for word in words:
        trie.insert(word)

    found: dict[str, bool] = {}
    for r in range(rows):
        for c in range(cols):
            found = collectWords(board, rows, cols, trie, 0, "", r, c, set(), found)

    out: list[str] = []
    for word in found.keys():
        out.append(word)
    return out

def main():
    expected_empty: list[str] = []
    assert sorted(findWords([["o", "a", "a", "n"], ["e", "t", "a", "e"], ["i", "h", "k", "r"], ["i", "f", "l", "v"]], ["oath", "pea", "eat", "rain"])) == ["eat", "oath"]
    assert sorted(findWords([["a", "b"], ["c", "d"]], ["abcb"])) == expected_empty
