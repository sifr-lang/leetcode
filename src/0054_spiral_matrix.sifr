# LeetCode 54: Spiral Matrix

def spiralOrder(matrix: list[list[int]]) -> list[int]:
    res: list[int] = []
    if len(matrix) == 0:
        return res

    first_row_opt: list[int] | None = matrix[0]
    if first_row_opt is None:
        return res
    first_row = first_row_opt
    left, right = 0, len(first_row)
    top, bottom = 0, len(matrix)

    while left < right and top < bottom:
        for i in range(left, right):
            top_value = matrix[top][i]
            if top_value is None:
                return res
            res.append(top_value)
        top += 1

        for i in range(top, bottom):
            right_value = matrix[i][right - 1]
            if right_value is None:
                return res
            res.append(right_value)
        right -= 1

        if not (left < right and top < bottom):
            break

        for i in range(right - 1, left - 1, -1):
            bottom_value = matrix[bottom - 1][i]
            if bottom_value is None:
                return res
            res.append(bottom_value)
        bottom -= 1

        for i in range(bottom - 1, top - 1, -1):
            left_value = matrix[i][left]
            if left_value is None:
                return res
            res.append(left_value)
        left += 1

    return res

def main():
    assert str(spiralOrder([[1,2,3],[4,5,6],[7,8,9]])) == '[1, 2, 3, 6, 9, 8, 7, 4, 5]'
