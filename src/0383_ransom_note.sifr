# LeetCode 383: Ransom Note

from sifr.collections import defaultdict

def canConstruct(ransomNote: str, magazine: str) -> bool:
    r_counter = defaultdict(int)
    m_counter = defaultdict(int)
    for c in ransomNote:
        r_counter[c] += 1
    for c in magazine:
        m_counter[c] += 1
    # magazine contains (>=) ransomNote
    for c in ransomNote:
        if m_counter[c] < r_counter[c]:
            return False
    return True

def main():
    assert str(canConstruct("a", "b")) == 'false'
    assert str(canConstruct("aa", "aab")) == 'true'
