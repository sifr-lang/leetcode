# LeetCode 1462: Course Schedule Iv

def _nz_int(value: int | None) -> int:
    if value is None:
        return 0
    return value

def _pair_key(a: int, b: int) -> str:
    return str(a) + "," + str(b)

def checkIfPrerequisite(numCourses: int, prerequisites: list[list[int]], queries: list[list[int]]) -> list[bool]:
    adj: dict[int, list[int]] = {}
    for edge in prerequisites:
        prereq = _nz_int(edge[0])
        crs = _nz_int(edge[1])
        if crs not in adj:
            adj[crs] = []
        if crs in adj:
            adj[crs].append(prereq)

    prereqMap: dict[int, set[int]] = {}

    def dfs(crs: int) -> set[int]:
        if crs not in prereqMap:
            collected: set[int] = set()
            if crs in adj:
                for pre in adj[crs]:
                    if pre is not None:
                        upstream = dfs(pre)
                        for item in upstream:
                            collected.add(item)
            prereqMap[crs] = collected

        result = prereqMap.get(crs, set())
        result.add(crs)
        prereqMap[crs] = result
        return result

    for crs in range(numCourses):
        dfs(crs)

    res = []
    for query in queries:
        u = _nz_int(query[0])
        v = _nz_int(query[1])
        prereqs = prereqMap.get(v, set())
        res.append(u in prereqs)
    return res

def main():
    assert checkIfPrerequisite(2, [[1, 0]], [[0, 1], [1, 0]]) == [False, True]
    assert checkIfPrerequisite(2, [], [[1, 0], [0, 1]]) == [False, False]
    assert checkIfPrerequisite(3, [[1, 2], [1, 0], [2, 0]], [[1, 0], [1, 2]]) == [True, True]
