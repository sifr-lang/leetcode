# LeetCode 323: Number Of Connected Components In An Undirected Graph

from helpers.dsu import UnionFind

def countComponents(n: int, edges: list[tuple[int, int]]) -> Result[int, Error]:
    try:
        dsu = UnionFind(n)
        for a, b in edges:
            joined: bool = dsu.union(a, b)
        return dsu.component_count()
    except Error as error:
        raise error

def main():
    try:
        count_components_result_1: int = countComponents(5, [(0, 1), (1, 2), (3, 4)])
        assert count_components_result_1 == 2
        count_components_result_2: int = countComponents(5, [(0, 1), (1, 2), (2, 3), (3, 4)])
        assert count_components_result_2 == 1
    except Error:
        assert False
